>>SOURCE FORMAT FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. inventory-service.

*> Legacy inventory HTTP service used as the migration reference.
*> The process owns its POSIX socket, calls libpq directly, and appends one
*> line-sequential event after each successful database reservation.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT OPTIONAL EVENT-FILE ASSIGN TO DYNAMIC WS-EVENT-PATH
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-EVENT-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD EVENT-FILE.
01 EVENT-RECORD PIC X(256).

WORKING-STORAGE SECTION.
78 AF-INET VALUE 2.
78 SOCK-STREAM VALUE 1.
78 SOL-SOCKET VALUE 1.
78 SO-REUSEADDR VALUE 2.
78 SO-RCVTIMEO VALUE 20.
78 SHUT-WR VALUE 1.
78 MSG-NOSIGNAL VALUE 16384.
78 CONNECTION-OK VALUE 0.
78 TUPLES-OK VALUE 2.
78 HTTP-OK VALUE 200.
78 HTTP-CREATED VALUE 201.
78 HTTP-BAD-REQUEST VALUE 400.
78 HTTP-NOT-FOUND VALUE 404.
78 HTTP-CONFLICT VALUE 409.
78 HTTP-INTERNAL-ERROR VALUE 500.

01 WS-ENVIRONMENT.
   05 WS-PORT-NAME PIC X(5) VALUE "PORT" & X"00".
   05 WS-DATABASE-NAME PIC X(13) VALUE "DATABASE_URL" & X"00".
   05 WS-EVENT-NAME PIC X(10) VALUE "EVENT_LOG" & X"00".
   05 WS-PORT-POINTER USAGE POINTER.
   05 WS-DATABASE-POINTER USAGE POINTER.
   05 WS-EVENT-POINTER USAGE POINTER.
   05 WS-PORT-TEXT PIC X(16).
   05 WS-PORT-NUMBER USAGE BINARY-SHORT UNSIGNED.
   05 WS-EVENT-PATH PIC X(512).

01 WS-C-STRING PIC X(512) BASED.

01 WS-SERVER.
   05 WS-SERVER-SOCKET USAGE BINARY-LONG VALUE -1.
   05 WS-CLIENT-SOCKET USAGE BINARY-LONG VALUE -1.
   05 WS-SOCKET-RESULT USAGE BINARY-LONG.
   05 WS-SOCKET-OPTION USAGE BINARY-LONG VALUE 1.
   05 WS-RECEIVE-TIMEOUT.
      10 WS-TIMEOUT-SECONDS USAGE BINARY-C-LONG VALUE 0.
      10 WS-TIMEOUT-MICROSECONDS USAGE BINARY-C-LONG VALUE 50000.
   05 WS-SOCKET-ADDRESS.
      10 WS-ADDRESS-FAMILY USAGE BINARY-SHORT UNSIGNED VALUE AF-INET.
      10 WS-ADDRESS-PORT USAGE BINARY-SHORT UNSIGNED.
      10 WS-ADDRESS-HOST USAGE BINARY-LONG UNSIGNED VALUE 0.
      10 WS-ADDRESS-PADDING PIC X(8) VALUE LOW-VALUES.

01 WS-REQUEST.
   05 WS-REQUEST-BUFFER PIC X(2048).
   05 WS-REQUEST-SIZE USAGE BINARY-C-LONG.
   05 WS-REQUEST-DRAIN PIC X(2048).
   05 WS-REQUEST-DRAIN-SIZE USAGE BINARY-C-LONG.
   05 WS-REQUEST-METHOD PIC X(16).
   05 WS-REQUEST-URL PIC X(256).
   05 WS-REQUEST-PATH PIC X(256).
   05 WS-REQUEST-REST PIC X(1776).
   05 WS-PATH-EMPTY PIC X(8).
   05 WS-PATH-RESOURCE PIC X(32).
   05 WS-PATH-SKU PIC X(64).
   05 WS-PATH-ACTION PIC X(32).
   05 WS-PATH-QUANTITY PIC X(16).
   05 WS-PATH-OVERFLOW PIC X(256).
   05 WS-TRAILING-SLASH PIC X VALUE "N".
      88 REQUEST-HAS-TRAILING-SLASH VALUE "Y".
   05 WS-VALID-SKU PIC X VALUE "N".
      88 SKU-IS-VALID VALUE "Y".
   05 WS-VALID-QUANTITY PIC X VALUE "N".
      88 QUANTITY-IS-VALID VALUE "Y".
   05 WS-CHARACTER-INDEX USAGE BINARY-LONG.
   05 WS-QUANTITY-NUMBER USAGE BINARY-LONG.
   05 WS-QUANTITY-DISPLAY PIC Z(3)9.

01 WS-DATABASE.
   05 WS-DB-CONNECTION USAGE POINTER.
   05 WS-CONNECTION-STATUS USAGE BINARY-LONG.
   05 WS-SQL-COMMAND PIC X(2048).
   05 WS-QUERY-RESULT USAGE POINTER.
   05 WS-QUERY-STATUS USAGE BINARY-LONG.
   05 WS-QUERY-STATE PIC X VALUE "N".
      88 QUERY-SUCCEEDED VALUE "Y".
   05 WS-ROW-COUNT USAGE BINARY-LONG.
   05 WS-VALUE-POINTER USAGE POINTER.
   05 WS-FIELD-TEXT PIC X(64).
   05 WS-RESERVED-NOW PIC X(8).
   05 WS-DB-SKU PIC X(32).
   05 WS-AVAILABLE-TEXT PIC X(16).
   05 WS-RESERVED-TEXT PIC X(16).
   05 WS-REMAINING-TEXT PIC X(16).
   05 WS-PARAMETER-COUNT USAGE BINARY-LONG.
   05 WS-PARAMETER-TYPE USAGE BINARY-LONG UNSIGNED OCCURS 2 TIMES.
   05 WS-SKU-PARAMETER PIC X(33).
   05 WS-QUANTITY-PARAMETER PIC X(5).
   05 WS-PARAMETER-POINTER USAGE POINTER OCCURS 2 TIMES.

01 WS-EVENT.
   05 WS-EVENT-FILE-STATUS PIC XX.
   05 WS-EVENT-STATE PIC X VALUE "N".
      88 EVENT-WRITE-SUCCEEDED VALUE "Y".

01 WS-RESPONSE.
   05 WS-RESPONSE-BODY PIC X(1024).
   05 WS-RESPONSE-LENGTH USAGE BINARY-C-LONG UNSIGNED.
   05 WS-RESPONSE-LENGTH-DISPLAY PIC Z(4)9.
   05 WS-RESPONSE-MESSAGE PIC X(1536).
   05 WS-RESPONSE-MESSAGE-LENGTH USAGE BINARY-C-LONG UNSIGNED.
   05 WS-RESPONSE-SEND-POINTER USAGE POINTER.
   05 WS-RESPONSE-SEND-COUNT USAGE BINARY-C-LONG.
   05 WS-RESPONSE-SEND-REMAINING USAGE BINARY-C-LONG.
   05 WS-RESPONSE-STATUS USAGE BINARY-LONG.
   05 WS-RESPONSE-STATUS-LINE PIC X(32).

PROCEDURE DIVISION.
    PERFORM INITIALIZE-SERVICE
    PERFORM SERVE-REQUESTS
    STOP RUN
    .

INITIALIZE-SERVICE.
    PERFORM READ-ENVIRONMENT
    PERFORM CONNECT-DATABASE
    PERFORM OPEN-SERVER.

READ-ENVIRONMENT.
    CALL "getenv" USING BY REFERENCE WS-PORT-NAME
        RETURNING WS-PORT-POINTER
    CALL "getenv" USING BY REFERENCE WS-DATABASE-NAME
        RETURNING WS-DATABASE-POINTER
    CALL "getenv" USING BY REFERENCE WS-EVENT-NAME
        RETURNING WS-EVENT-POINTER
    IF WS-PORT-POINTER = NULL
       OR WS-DATABASE-POINTER = NULL
       OR WS-EVENT-POINTER = NULL
        DISPLAY "PORT, DATABASE_URL, and EVENT_LOG are required" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    SET ADDRESS OF WS-C-STRING TO WS-PORT-POINTER
    MOVE SPACES TO WS-PORT-TEXT
    UNSTRING WS-C-STRING DELIMITED BY LOW-VALUE INTO WS-PORT-TEXT
    IF FUNCTION TEST-NUMVAL(FUNCTION TRIM(WS-PORT-TEXT)) NOT = 0
        DISPLAY "PORT must be a valid TCP port" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF
    MOVE FUNCTION NUMVAL(WS-PORT-TEXT) TO WS-PORT-NUMBER
    IF WS-PORT-NUMBER = 0
        DISPLAY "PORT must be a valid TCP port" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    SET ADDRESS OF WS-C-STRING TO WS-EVENT-POINTER
    MOVE SPACES TO WS-EVENT-PATH
    UNSTRING WS-C-STRING DELIMITED BY LOW-VALUE INTO WS-EVENT-PATH.

CONNECT-DATABASE.
    CALL "PQconnectdb"
        USING BY VALUE WS-DATABASE-POINTER
        RETURNING WS-DB-CONNECTION
    END-CALL
    IF WS-DB-CONNECTION = NULL
        DISPLAY "database connection failed" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF
    CALL "PQstatus"
        USING BY VALUE WS-DB-CONNECTION
        RETURNING WS-CONNECTION-STATUS
    END-CALL
    IF WS-CONNECTION-STATUS NOT = CONNECTION-OK
        PERFORM DISPLAY-DATABASE-ERROR
        CALL "PQfinish" USING BY VALUE WS-DB-CONNECTION END-CALL
        STOP RUN RETURNING 1
    END-IF.

OPEN-SERVER.
    CALL "socket"
        USING BY VALUE AF-INET BY VALUE SOCK-STREAM BY VALUE 0
        RETURNING WS-SERVER-SOCKET
    END-CALL
    IF WS-SERVER-SOCKET < 0
        DISPLAY "socket failed" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    CALL "setsockopt"
        USING BY VALUE WS-SERVER-SOCKET
              BY VALUE SOL-SOCKET
              BY VALUE SO-REUSEADDR
              BY REFERENCE WS-SOCKET-OPTION
              BY VALUE LENGTH OF WS-SOCKET-OPTION
        RETURNING WS-SOCKET-RESULT
    END-CALL
    IF WS-SOCKET-RESULT < 0
        DISPLAY "setsockopt failed" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    CALL "htons" USING BY VALUE WS-PORT-NUMBER
        RETURNING WS-ADDRESS-PORT
    CALL "bind"
        USING BY VALUE WS-SERVER-SOCKET
              BY REFERENCE WS-SOCKET-ADDRESS
              BY VALUE LENGTH OF WS-SOCKET-ADDRESS
        RETURNING WS-SOCKET-RESULT
    END-CALL
    IF WS-SOCKET-RESULT < 0
        DISPLAY "bind failed" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF

    CALL "listen"
        USING BY VALUE WS-SERVER-SOCKET BY VALUE 16
        RETURNING WS-SOCKET-RESULT
    END-CALL
    IF WS-SOCKET-RESULT < 0
        DISPLAY "listen failed" UPON SYSERR
        STOP RUN RETURNING 1
    END-IF.

SERVE-REQUESTS.
    PERFORM FOREVER
        PERFORM ACCEPT-REQUEST
    END-PERFORM.

ACCEPT-REQUEST.
    CALL "accept4"
        USING BY VALUE WS-SERVER-SOCKET
              BY VALUE 0
              BY VALUE 0
              BY VALUE 0
        RETURNING WS-CLIENT-SOCKET
    END-CALL
    IF WS-CLIENT-SOCKET < 0
        EXIT PARAGRAPH
    END-IF

    CALL "setsockopt"
        USING BY VALUE WS-CLIENT-SOCKET
              BY VALUE SOL-SOCKET
              BY VALUE SO-RCVTIMEO
              BY REFERENCE WS-RECEIVE-TIMEOUT
              BY VALUE LENGTH OF WS-RECEIVE-TIMEOUT
        RETURNING WS-SOCKET-RESULT
    END-CALL
    IF WS-SOCKET-RESULT < 0
        DISPLAY "client setsockopt failed" UPON SYSERR
    END-IF

    PERFORM HANDLE-REQUEST
    PERFORM CLOSE-CLIENT.

CLOSE-CLIENT.
    CALL "shutdown"
        USING BY VALUE WS-CLIENT-SOCKET BY VALUE SHUT-WR
        RETURNING WS-SOCKET-RESULT
    END-CALL
    MOVE 1 TO WS-REQUEST-DRAIN-SIZE
    PERFORM UNTIL WS-REQUEST-DRAIN-SIZE <= 0
        CALL "recv"
            USING BY VALUE WS-CLIENT-SOCKET
                  BY REFERENCE WS-REQUEST-DRAIN
                  BY VALUE LENGTH OF WS-REQUEST-DRAIN
                  BY VALUE 0
            RETURNING WS-REQUEST-DRAIN-SIZE
        END-CALL
    END-PERFORM
    CALL "close" USING BY VALUE WS-CLIENT-SOCKET END-CALL
    MOVE -1 TO WS-CLIENT-SOCKET.

HANDLE-REQUEST.
    INITIALIZE WS-REQUEST-BUFFER WS-REQUEST-METHOD WS-REQUEST-URL
        WS-REQUEST-PATH WS-REQUEST-REST WS-PATH-EMPTY WS-PATH-RESOURCE
        WS-PATH-SKU WS-PATH-ACTION WS-PATH-QUANTITY WS-PATH-OVERFLOW
    MOVE "N" TO WS-TRAILING-SLASH
    CALL "recv"
        USING BY VALUE WS-CLIENT-SOCKET
              BY REFERENCE WS-REQUEST-BUFFER
              BY VALUE LENGTH OF WS-REQUEST-BUFFER
              BY VALUE 0
        RETURNING WS-REQUEST-SIZE
    END-CALL
    IF WS-REQUEST-SIZE <= 0
        EXIT PARAGRAPH
    END-IF

    UNSTRING WS-REQUEST-BUFFER DELIMITED BY SPACE
        INTO WS-REQUEST-METHOD WS-REQUEST-URL WS-REQUEST-REST
    END-UNSTRING
    UNSTRING WS-REQUEST-URL DELIMITED BY "?" INTO WS-REQUEST-PATH
    END-UNSTRING
    IF FUNCTION STORED-CHAR-LENGTH(WS-REQUEST-PATH) > 1
       AND WS-REQUEST-PATH(
           FUNCTION STORED-CHAR-LENGTH(WS-REQUEST-PATH):1) = "/"
        MOVE "Y" TO WS-TRAILING-SLASH
    END-IF
    UNSTRING WS-REQUEST-PATH DELIMITED BY "/"
        INTO WS-PATH-EMPTY WS-PATH-RESOURCE WS-PATH-SKU
             WS-PATH-ACTION WS-PATH-QUANTITY WS-PATH-OVERFLOW
    END-UNSTRING

    EVALUATE TRUE
        WHEN WS-REQUEST-METHOD = "GET" AND WS-REQUEST-PATH = "/health"
            MOVE HTTP-OK TO WS-RESPONSE-STATUS
            MOVE '{"status":"ok"}' TO WS-RESPONSE-BODY
        WHEN WS-REQUEST-METHOD = "GET"
             AND WS-PATH-RESOURCE = "inventory"
             AND WS-PATH-SKU NOT = SPACES
             AND WS-PATH-ACTION = SPACES
             AND WS-PATH-QUANTITY = SPACES
             AND WS-PATH-OVERFLOW = SPACES
             AND NOT REQUEST-HAS-TRAILING-SLASH
            PERFORM VALIDATE-SKU
            IF SKU-IS-VALID
                PERFORM GET-INVENTORY
            ELSE
                PERFORM BAD-REQUEST
            END-IF
        WHEN WS-REQUEST-METHOD = "POST"
             AND WS-PATH-RESOURCE = "inventory"
             AND WS-PATH-SKU NOT = SPACES
             AND WS-PATH-ACTION = "reservations"
             AND WS-PATH-QUANTITY NOT = SPACES
             AND WS-PATH-OVERFLOW = SPACES
             AND NOT REQUEST-HAS-TRAILING-SLASH
            PERFORM VALIDATE-SKU
            PERFORM VALIDATE-QUANTITY
            IF SKU-IS-VALID AND QUANTITY-IS-VALID
                PERFORM RESERVE-INVENTORY
            ELSE
                PERFORM BAD-REQUEST
            END-IF
        WHEN OTHER
            PERFORM NOT-FOUND
    END-EVALUATE
    PERFORM SEND-RESPONSE.

VALIDATE-SKU.
    MOVE "N" TO WS-VALID-SKU
    IF FUNCTION STORED-CHAR-LENGTH(WS-PATH-SKU) < 1
       OR FUNCTION STORED-CHAR-LENGTH(WS-PATH-SKU) > 32
        EXIT PARAGRAPH
    END-IF

    MOVE "Y" TO WS-VALID-SKU
    PERFORM VARYING WS-CHARACTER-INDEX FROM 1 BY 1
        UNTIL WS-CHARACTER-INDEX > FUNCTION STORED-CHAR-LENGTH(WS-PATH-SKU)
        IF WS-PATH-SKU(WS-CHARACTER-INDEX:1) < "a"
           OR WS-PATH-SKU(WS-CHARACTER-INDEX:1) > "z"
            IF WS-PATH-SKU(WS-CHARACTER-INDEX:1) < "0"
               OR WS-PATH-SKU(WS-CHARACTER-INDEX:1) > "9"
                IF WS-PATH-SKU(WS-CHARACTER-INDEX:1) NOT = "-"
                    MOVE "N" TO WS-VALID-SKU
                END-IF
            END-IF
        END-IF
    END-PERFORM.

VALIDATE-QUANTITY.
    MOVE "N" TO WS-VALID-QUANTITY
    IF FUNCTION STORED-CHAR-LENGTH(WS-PATH-QUANTITY) < 1
       OR FUNCTION STORED-CHAR-LENGTH(WS-PATH-QUANTITY) > 4
        EXIT PARAGRAPH
    END-IF

    MOVE "Y" TO WS-VALID-QUANTITY
    PERFORM VARYING WS-CHARACTER-INDEX FROM 1 BY 1
        UNTIL WS-CHARACTER-INDEX > FUNCTION STORED-CHAR-LENGTH(WS-PATH-QUANTITY)
        IF WS-PATH-QUANTITY(WS-CHARACTER-INDEX:1) < "0"
           OR WS-PATH-QUANTITY(WS-CHARACTER-INDEX:1) > "9"
            MOVE "N" TO WS-VALID-QUANTITY
        END-IF
    END-PERFORM
    IF QUANTITY-IS-VALID
        MOVE FUNCTION NUMVAL(WS-PATH-QUANTITY) TO WS-QUANTITY-NUMBER
        IF WS-QUANTITY-NUMBER < 1 OR WS-QUANTITY-NUMBER > 9999
            MOVE "N" TO WS-VALID-QUANTITY
        END-IF
    END-IF.

GET-INVENTORY.
    MOVE LOW-VALUES TO WS-SQL-COMMAND
    STRING
        "SELECT sku, available, reserved, available - reserved AS remaining "
        "FROM inventory WHERE sku = $1"
        X"00"
        DELIMITED BY SIZE INTO WS-SQL-COMMAND
    END-STRING
    PERFORM SET-SKU-PARAMETER
    MOVE 25 TO WS-PARAMETER-TYPE(1)
    MOVE 1 TO WS-PARAMETER-COUNT
    PERFORM EXECUTE-QUERY
    IF QUERY-SUCCEEDED
        IF WS-ROW-COUNT = 0
            PERFORM NOT-FOUND
        ELSE
            PERFORM READ-INVENTORY-ROW
            MOVE HTTP-OK TO WS-RESPONSE-STATUS
            PERFORM INVENTORY-RESPONSE
        END-IF
    END-IF
    PERFORM CLEAR-QUERY.

RESERVE-INVENTORY.
    MOVE WS-QUANTITY-NUMBER TO WS-QUANTITY-DISPLAY
    MOVE LOW-VALUES TO WS-SQL-COMMAND
    STRING
        "WITH updated AS ("
        "UPDATE inventory SET reserved = reserved + $2 "
        "WHERE sku = $1 AND available - reserved >= $2 "
        "RETURNING sku, available, reserved, available - reserved AS remaining"
        ") SELECT TRUE AS reserved_now, sku, available, reserved, remaining "
        "FROM updated UNION ALL "
        "SELECT FALSE AS reserved_now, sku, available, reserved, "
        "available - reserved FROM inventory "
        "WHERE sku = $1 AND NOT EXISTS (SELECT 1 FROM updated)"
        X"00"
        DELIMITED BY SIZE INTO WS-SQL-COMMAND
    END-STRING
    PERFORM SET-SKU-PARAMETER
    MOVE LOW-VALUES TO WS-QUANTITY-PARAMETER
    STRING FUNCTION TRIM(WS-QUANTITY-DISPLAY) X"00"
        DELIMITED BY SIZE INTO WS-QUANTITY-PARAMETER
    END-STRING
    SET WS-PARAMETER-POINTER(2) TO ADDRESS OF WS-QUANTITY-PARAMETER
    MOVE 25 TO WS-PARAMETER-TYPE(1)
    MOVE 23 TO WS-PARAMETER-TYPE(2)
    MOVE 2 TO WS-PARAMETER-COUNT
    PERFORM EXECUTE-QUERY
    IF QUERY-SUCCEEDED
        IF WS-ROW-COUNT = 0
            PERFORM NOT-FOUND
        ELSE
            PERFORM READ-RESERVATION-ROW
            IF WS-RESERVED-NOW = "t"
                PERFORM WRITE-EVENT
                IF EVENT-WRITE-SUCCEEDED
                    MOVE HTTP-CREATED TO WS-RESPONSE-STATUS
                    PERFORM INVENTORY-RESPONSE
                ELSE
                    PERFORM INTERNAL-ERROR
                END-IF
            ELSE
                MOVE HTTP-CONFLICT TO WS-RESPONSE-STATUS
                INITIALIZE WS-RESPONSE-BODY
                STRING
                    '{"error":"insufficient_stock","sku":"'
                    FUNCTION TRIM(WS-DB-SKU)
                    '","available":' FUNCTION TRIM(WS-AVAILABLE-TEXT)
                    ',"reserved":' FUNCTION TRIM(WS-RESERVED-TEXT)
                    ',"requested":' FUNCTION TRIM(WS-QUANTITY-DISPLAY) "}"
                    DELIMITED BY SIZE INTO WS-RESPONSE-BODY
                END-STRING
            END-IF
        END-IF
    END-IF
    PERFORM CLEAR-QUERY.

SET-SKU-PARAMETER.
    MOVE LOW-VALUES TO WS-SKU-PARAMETER
    STRING FUNCTION TRIM(WS-PATH-SKU) X"00"
        DELIMITED BY SIZE INTO WS-SKU-PARAMETER
    END-STRING
    SET WS-PARAMETER-POINTER(1) TO ADDRESS OF WS-SKU-PARAMETER.

EXECUTE-QUERY.
    MOVE "Y" TO WS-QUERY-STATE
    SET WS-QUERY-RESULT TO NULL
    CALL "PQexecParams"
        USING BY VALUE WS-DB-CONNECTION
              BY REFERENCE WS-SQL-COMMAND
              BY VALUE WS-PARAMETER-COUNT
              BY REFERENCE WS-PARAMETER-TYPE(1)
              BY REFERENCE WS-PARAMETER-POINTER(1)
              BY VALUE 0
              BY VALUE 0
              BY VALUE 0
        RETURNING WS-QUERY-RESULT
    END-CALL
    IF WS-QUERY-RESULT = NULL
        PERFORM DATABASE-ERROR
        EXIT PARAGRAPH
    END-IF

    CALL "PQresultStatus"
        USING BY VALUE WS-QUERY-RESULT
        RETURNING WS-QUERY-STATUS
    END-CALL
    IF WS-QUERY-STATUS NOT = TUPLES-OK
        PERFORM DATABASE-ERROR
        EXIT PARAGRAPH
    END-IF
    CALL "PQntuples"
        USING BY VALUE WS-QUERY-RESULT
        RETURNING WS-ROW-COUNT
    END-CALL.

READ-INVENTORY-ROW.
    MOVE 0 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-DB-SKU
    MOVE 1 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-AVAILABLE-TEXT
    MOVE 2 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-RESERVED-TEXT
    MOVE 3 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-REMAINING-TEXT.

READ-RESERVATION-ROW.
    MOVE 0 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-RESERVED-NOW
    MOVE 1 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-DB-SKU
    MOVE 2 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-AVAILABLE-TEXT
    MOVE 3 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-RESERVED-TEXT
    MOVE 4 TO WS-CHARACTER-INDEX
    PERFORM READ-FIELD
    MOVE WS-FIELD-TEXT TO WS-REMAINING-TEXT.

READ-FIELD.
    CALL "PQgetvalue"
        USING BY VALUE WS-QUERY-RESULT
              BY VALUE 0
              BY VALUE WS-CHARACTER-INDEX
        RETURNING WS-VALUE-POINTER
    END-CALL
    SET ADDRESS OF WS-C-STRING TO WS-VALUE-POINTER
    MOVE SPACES TO WS-FIELD-TEXT
    UNSTRING WS-C-STRING DELIMITED BY LOW-VALUE INTO WS-FIELD-TEXT.

CLEAR-QUERY.
    IF WS-QUERY-RESULT NOT = NULL
        CALL "PQclear" USING BY VALUE WS-QUERY-RESULT END-CALL
        SET WS-QUERY-RESULT TO NULL
    END-IF.

DATABASE-ERROR.
    MOVE "N" TO WS-QUERY-STATE
    PERFORM INTERNAL-ERROR
    PERFORM DISPLAY-DATABASE-ERROR
    MOVE 0 TO WS-ROW-COUNT.

DISPLAY-DATABASE-ERROR.
    IF WS-DB-CONNECTION NOT = NULL
        CALL "PQerrorMessage"
            USING BY VALUE WS-DB-CONNECTION
            RETURNING WS-VALUE-POINTER
        END-CALL
        IF WS-VALUE-POINTER NOT = NULL
            SET ADDRESS OF WS-C-STRING TO WS-VALUE-POINTER
            MOVE SPACES TO WS-FIELD-TEXT
            UNSTRING WS-C-STRING DELIMITED BY LOW-VALUE INTO WS-FIELD-TEXT
            DISPLAY "database operation failed: "
                FUNCTION TRIM(WS-FIELD-TEXT) UPON SYSERR
        END-IF
    END-IF.

WRITE-EVENT.
    MOVE "N" TO WS-EVENT-STATE
    INITIALIZE EVENT-RECORD
    STRING
        "reserved|" FUNCTION TRIM(WS-DB-SKU) "|"
        FUNCTION TRIM(WS-QUANTITY-DISPLAY) "|"
        FUNCTION TRIM(WS-RESERVED-TEXT) "|"
        FUNCTION TRIM(WS-REMAINING-TEXT)
        DELIMITED BY SIZE INTO EVENT-RECORD
    END-STRING

    OPEN EXTEND EVENT-FILE
    IF WS-EVENT-FILE-STATUS NOT = "00"
        DISPLAY "reservation event open failed" UPON SYSERR
        EXIT PARAGRAPH
    END-IF
    WRITE EVENT-RECORD
    IF WS-EVENT-FILE-STATUS = "00"
        MOVE "Y" TO WS-EVENT-STATE
    ELSE
        DISPLAY "reservation event write failed" UPON SYSERR
    END-IF
    CLOSE EVENT-FILE.

INVENTORY-RESPONSE.
    INITIALIZE WS-RESPONSE-BODY
    STRING
        '{"sku":"' FUNCTION TRIM(WS-DB-SKU)
        '","available":' FUNCTION TRIM(WS-AVAILABLE-TEXT)
        ',"reserved":' FUNCTION TRIM(WS-RESERVED-TEXT)
        ',"remaining":' FUNCTION TRIM(WS-REMAINING-TEXT) "}"
        DELIMITED BY SIZE INTO WS-RESPONSE-BODY
    END-STRING.

BAD-REQUEST.
    MOVE HTTP-BAD-REQUEST TO WS-RESPONSE-STATUS
    MOVE '{"error":"invalid_request"}' TO WS-RESPONSE-BODY.

NOT-FOUND.
    MOVE HTTP-NOT-FOUND TO WS-RESPONSE-STATUS
    MOVE '{"error":"not_found"}' TO WS-RESPONSE-BODY.

INTERNAL-ERROR.
    MOVE HTTP-INTERNAL-ERROR TO WS-RESPONSE-STATUS
    MOVE '{"error":"internal"}' TO WS-RESPONSE-BODY.

SEND-RESPONSE.
    EVALUATE WS-RESPONSE-STATUS
        WHEN HTTP-OK
            MOVE "200 OK" TO WS-RESPONSE-STATUS-LINE
        WHEN HTTP-CREATED
            MOVE "201 Created" TO WS-RESPONSE-STATUS-LINE
        WHEN HTTP-BAD-REQUEST
            MOVE "400 Bad Request" TO WS-RESPONSE-STATUS-LINE
        WHEN HTTP-NOT-FOUND
            MOVE "404 Not Found" TO WS-RESPONSE-STATUS-LINE
        WHEN HTTP-CONFLICT
            MOVE "409 Conflict" TO WS-RESPONSE-STATUS-LINE
        WHEN OTHER
            MOVE "500 Internal Server Error" TO WS-RESPONSE-STATUS-LINE
    END-EVALUATE
    MOVE FUNCTION STORED-CHAR-LENGTH(WS-RESPONSE-BODY)
        TO WS-RESPONSE-LENGTH
    MOVE WS-RESPONSE-LENGTH TO WS-RESPONSE-LENGTH-DISPLAY
    INITIALIZE WS-RESPONSE-MESSAGE
    STRING
        "HTTP/1.1 " FUNCTION TRIM(WS-RESPONSE-STATUS-LINE) X"0D0A"
        "Content-Type: application/json" X"0D0A"
        "Content-Length: " FUNCTION TRIM(WS-RESPONSE-LENGTH-DISPLAY) X"0D0A"
        "Connection: close" X"0D0A" X"0D0A"
        WS-RESPONSE-BODY(1:WS-RESPONSE-LENGTH)
        DELIMITED BY SIZE INTO WS-RESPONSE-MESSAGE
    END-STRING
    MOVE FUNCTION STORED-CHAR-LENGTH(WS-RESPONSE-MESSAGE)
        TO WS-RESPONSE-MESSAGE-LENGTH
    SET WS-RESPONSE-SEND-POINTER TO ADDRESS OF WS-RESPONSE-MESSAGE
    MOVE WS-RESPONSE-MESSAGE-LENGTH TO WS-RESPONSE-SEND-REMAINING
    PERFORM UNTIL WS-RESPONSE-SEND-REMAINING <= 0
        CALL "send"
            USING BY VALUE WS-CLIENT-SOCKET
                  BY VALUE WS-RESPONSE-SEND-POINTER
                  BY VALUE WS-RESPONSE-SEND-REMAINING
                  BY VALUE MSG-NOSIGNAL
            RETURNING WS-RESPONSE-SEND-COUNT
        END-CALL
        IF WS-RESPONSE-SEND-COUNT <= 0
            EXIT PERFORM
        END-IF
        SUBTRACT WS-RESPONSE-SEND-COUNT FROM WS-RESPONSE-SEND-REMAINING
        SET WS-RESPONSE-SEND-POINTER UP BY WS-RESPONSE-SEND-COUNT
    END-PERFORM.

END PROGRAM inventory-service.
