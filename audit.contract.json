{
  "schema": 2,
  "mode": "required",
  "proofs": [
    "inventory.invalid-reservation",
    "inventory.missing",
    "inventory.reject",
    "inventory.reserve",
    "inventory.show"
  ],
  "live": true,
  "offline": true,
  "views": {
    "inventory.invalid-reservation": ["events", "inventory"],
    "inventory.missing": ["events", "inventory", "postgres"],
    "inventory.reject": ["events", "inventory", "postgres"],
    "inventory.reserve": [
      "events",
      "filesystem",
      "filesystem_state",
      "inventory",
      "postgres",
      "postgres_state_state"
    ],
    "inventory.show": ["events", "inventory", "postgres"]
  },
  "defects": {
    "missing-event": ["views.events", "views.filesystem"],
    "split-reservation": ["views.postgres"]
  }
}
